<?php
$topPeriod = 'all/'.config('chart-top-time', 'this-week');
$hotPeriod = 'all/'.config('chart-new-hot-time', 'this-week');
$topTracks = $C->model('track')->getTracks('charts-top', $topPeriod, 0, 4);
$tracks = $C->model('track')->getTracks('charts-new-hot', $hotPeriod, 0, 10);
?>
<div class="bc-browse-overview">
    <section class="bc-chart-page">
        <header><h2><?php _l('this-week-top-50')?></h2><a data-ajax="true" href="<?php echo url('charts/top')?>"><?php _l('see-all')?> ↗</a></header>
        <?php if ($topTracks):?>
            <div class="bc-chart-legend" aria-hidden="true"><span>#</span><span><?php _l('title')?></span><span><?php _l('artist')?></span><span><?php _l('duration')?></span></div>
            <?php echo $C->view('track/lists', array('tracks'=>$topTracks, 'type'=>'charts-top', 'typeId'=>$topPeriod, 'viewType'=>'inline', 'offset'=>0))?>
        <?php else:?>
            <?php echo $C->view('track/empty', array('type'=>'charts-top'))?>
        <?php endif?>
    </section>
    <?php if ($tracks):?>
    <section class="horizontal-list">
        <header><h2><?php _l('new-hot')?></h2><a data-ajax="true" href="<?php echo url('charts')?>"><?php _l('see-all')?> ↗</a></header>
        <div class="slider" >
            <div class="swiper-container" id="new-hot-slider">
                <div class="swiper-wrapper">
                    <?php foreach($tracks as $track):?>
                        <?php echo $C->view('track/track-slide', array('track' => $track, 'type' => 'charts-new-hot', 'typeId' => $hotPeriod))?>
                    <?php endforeach;?>
                </div>
            </div>
            <div class="swiper-button-next  scroller scroll-right" id="new-hot-slider-next"><i class="la  la-angle-right"></i></div>
            <div class="swiper-button-prev scroller scroll-left" id="new-hot-slider-right"><i class="la  la-angle-left"></i></div>
        </div>
    </section>
    <?php endif?>
    <section class="bc-browse-artists">
        <header><h2><?php _l('top-artists')?></h2><a data-ajax="true" href="<?php echo url('discover/artists')?>"><?php _l('see-all')?> ↗</a></header>
        <div class="grid-container bc-artist-grid">
            <?php foreach ($C->model('user')->getPeople('top', '', 10, 0) as $user):?>
                <?php echo $C->view('user/display-grid', array('user'=>$user))?>
            <?php endforeach?>
        </div>
    </section>
</div>
