<?php
$C->useBreadcrumbs = false;
$isFeed = $C->request->input('filter') === 'feed';
?>
<div class="inner-container bc-home">
    <header class="bc-home-heading">
        <h1><?php _l('home')?></h1>
        <nav aria-label="<?php _l('home')?>">
            <a data-ajax="true" href="<?php echo url('')?>" <?php if (!$isFeed):?>aria-current="page"<?php endif?>><?php _l('summary-for-you')?></a>
            <a data-ajax="true" href="<?php echo url('', array('filter'=>'feed'))?>" <?php if ($isFeed):?>aria-current="page"<?php endif?>><?php _l('feed')?></a>
        </nav>
    </header>
    <?php if (!$isFeed):?>
        <?php
        $library = $C->model('track');
        $type = 'album';
        $typeId = 'discover';
        $playlists = $library->listPlaylists($type, $typeId, 12);
        foreach ($playlists as $release):
            if (!$library->canViewPrivateAlbum($release) || !$library->displayItem($release)) continue;
            $firstTrack = $library->getPlaylistFirstTrack($release['id']);
            if (!$firstTrack) continue;
            $artist = $C->model('user')->getUser($release['userid']);
            $escape = function ($text) { return htmlspecialchars((string)$text, ENT_QUOTES, 'UTF-8'); };
        ?>
            <a class="bc-home-release" data-ajax="true" href="<?php echo $escape($library->playlistUrl($release))?>">
                <span><small><?php _l('new-albums')?></small><strong><?php echo $escape($release['name'])?></strong>
                    <?php echo $escape($artist['full_name'])?> · <?php echo (int)$library->countPlaylistTracks($release['id'])?> <?php _l('tracks')?>
                </span>
                <img src="<?php echo $escape($library->getPlaylistArt($release, $artist, $firstTrack, 600))?>" alt="">
            </a>
        <?php break; endforeach?>
        <?php if(moduleExists('spotlight')):?>
            <?php $tracks = model('spotlight::spotlight')->getTracks(null, true,15)?>
            <?php if(count($tracks) > 0):?>
                <div class="horizontal-list">
                    <div class="clearfix">
                        <div class="float-left" style="width: 80%">
                            <div class="title">
                                <span><?php _l('featured')?></span>
                                <?php _l('made-for-you')?>

                            </div>
                        </div>
                        <div class="float-right">

                        </div>
                    </div>


                    <div class="slider full-slider " >
                        <div class="swiper-container" id="top-50-slider">
                            <div class="swiper-wrapper">
                                <?php  foreach($tracks as $track):?>
                                    <?php if($track['trackid']):$track = model('track')->findTrack($track['trackid'])?>
                                        <?php if($track):?>
                                            <?php echo $C->view('track/track-slide', array('track' => $track, 'type' => 'global-spotlight', 'home' => true,'typeId' => '', 'hideTags' => true,'hideAbout' => true))?>
                                        <?php endif?>
                                    <?php endif?>
                                <?php endforeach;?>

                            </div>
                        </div>
                        <div class="swiper-button-next  scroller scroll-right" id="new-hot-slider-next"><i class="la  la-angle-right"></i></div>
                        <div class="swiper-button-prev scroller scroll-left" id="new-hot-slider-right"><i class="la  la-angle-left"></i></div>
                    </div>
                </div>
            <?php endif?>
        <?php endif?>


        <section class="bc-home-chart">
            <header><h2><?php _l('top-songs')?></h2>
                <ul class="nav bc-home-periods" role="tablist">
                    <?php $periods = array('this-week','this-month','this-year'); foreach ($periods as $i=>$period):?>
                        <li class="nav-item"><a id="tab-<?php echo $period?>" class="nav-link <?php if (!$i) echo 'active'?>" data-toggle="tab" role="tab"
                            aria-selected="<?php echo $i ? 'false' : 'true'?>" href="#chart-<?php echo $period?>"><?php _l($period)?></a></li>
                    <?php endforeach?>
                </ul>
            </header>
            <div class="tab-content">
                <?php foreach ($periods as $i=>$period):?>
                    <div class="tab-pane fade <?php if (!$i) echo 'show active'?>" id="chart-<?php echo $period?>" role="tabpanel" aria-labelledby="tab-<?php echo $period?>">
                        <div class="track-list" data-no-paginate="true" data-limit="10" data-view="inline" data-type-id="all/<?php echo $period?>" data-type="charts-top" data-offset="0">
                            <?php echo $C->view('track/placeholder', array('type'=>'inline'))?>
                        </div>
                    </div>
                <?php endforeach?>
            </div>
        </section>
        <?php if ($playlists):?>
            <section class="bc-home-albums"><h2><?php _l('new-albums')?></h2>
                <div data-paginate-url="playlist/paginate" data-offset="0"
                     data-param="<?php echo perfectSerialize(array('type'=>$type, 'typeId'=>$typeId, 'limit'=>20))?>"
                     class="playlists-container grid-container clearfix home-album-container" id="playlists-album-discover">
                    <?php foreach ($playlists as $playlist):?>
                        <?php if ($library->canViewPrivateAlbum($playlist) && $library->displayItem($playlist)):?>
                            <?php echo $C->view('playlist/display', array('playlist'=>$playlist,'noTrackCount'=>true))?>
                        <?php endif?>
                    <?php endforeach?>
                </div>
            </section>
        <?php endif?>
    <?php else:?>
        <div class="row bc-home-feed">
            <div class="col-md-8"><h2><?php _l('following')?></h2>
                <?php Hook::getInstance()->fire('feed.top.extend')?>
                <?php echo $content?>
            </div>
            <div class="col-md-4 pt-2">
                <?php echo $C->view('home/general-right', array('stats' => true))?>
            </div>


        </div>
    <?php endif?>
</div>