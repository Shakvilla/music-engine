<?php
$filterUrl = function ($genreId, $period) {
    return htmlspecialchars(url('charts/top', array('genre'=>rawurlencode($genreId), 'time'=>rawurlencode($period))), ENT_QUOTES, 'UTF-8');
};
?>
<main class="inner-container bc-song-chart">
    <header class="bc-song-heading">
        <h1><?php _l('top-songs')?></h1>
        <div class="bc-song-filters">
            <select aria-label="<?php _l('chart-period')?>" onchange="load_page(this.value)">
                <?php foreach (array('this-week','last-week','this-month','last-month','this-year') as $period):?>
                    <option value="<?php echo $filterUrl($genre,$period)?>" <?php if ($period === $time):?>selected<?php endif?>>
                        <?php _l(strpos($period,'last-') === 0 ? 'from-'.$period : $period)?>
                    </option>
                <?php endforeach?>
            </select>
            <select aria-label="<?php _l('genre')?>" onchange="load_page(this.value)">
                <option value="<?php echo $filterUrl('all',$time)?>"><?php _l('all-genres')?></option>
                <?php foreach ($C->model('admin')->getGenres() as $item):?>
                    <option data-genre="<?php echo (int)$item['id']?>" value="<?php echo $filterUrl($item['id'],$time)?>" <?php if ($item['id'] == $genre):?>selected<?php endif?>>
                        <?php echo htmlspecialchars(l($item['name']), ENT_QUOTES, 'UTF-8')?>
                    </option>
                <?php endforeach?>
            </select>
        </div>
    </header>
    <?php Hook::getInstance()->fire('global.top')?>
    <?php echo config('ad-unit1')?>
    <div class="bc-song-columns">
        <div>
            <div class="track-list" data-limit="10" data-view="inline" data-type-id="<?php echo htmlspecialchars($genre.'/'.$time, ENT_QUOTES, 'UTF-8')?>" data-type="charts-top" data-offset="0">
                <?php echo $C->view('track/placeholder', array('type'=>'inline'))?>
            </div>
            <a href="" class="track-paginate-link show-mobile-sm show-mobile-md" onclick="return paginateTracks()"><?php _l('load-more-tracks')?></a>
        </div>
        <section class="bc-song-detail" aria-label="<?php _l('details')?>" aria-live="polite" hidden></section>
    </div>
</main>
